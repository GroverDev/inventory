# ─────────────────────────────────────────────────────────────────────────────
# Copia este archivo a .env y completa los valores reales.
#   cp .env.example .env
# .env NUNCA se sube al repositorio (está en .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# Base de datos
DB_USER=postgres
DB_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURA

# JWT — el token se firma con HMAC-SHA512: mínimo 64 caracteres (64 bytes).
# Generar con:  openssl rand -hex 32
JWT_SECRET=CAMBIAR_SECRETO_JWT_MINIMO_64_CARACTERES
JWT_ISSUER=PuntoDeVenta
JWT_AUDIENCE=PuntoDeVenta
JWT_TIME_TOKEN=2000

# MFA / TOTP  (32 bytes en hexadecimal = exactamente 64 caracteres)
MFA_ENCRYPTION_KEY=CAMBIAR_64_CARACTERES_HEX

# Límites de descuento que puede aplicar un Cajero sin autorización de supervisor
POS_MAX_CASHIER_DISCOUNT_PCT=15
POS_MAX_CASHIER_DISCOUNT_AMOUNT=50
