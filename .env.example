# ─────────────────────────────────────────────────────────────────────────────
# Copia este archivo a .env y completa los valores reales.
#   cp .env.example .env
# .env NUNCA se sube al repositorio (está en .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# Base de datos
DB_USER=postgres
DB_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURA

# JWT — el token se firma con HMAC-SHA512: mínimo 64 caracteres (64 bytes).
# Generar con:  openssl rand -hex 32
JWT_SECRET=CAMBIAR_SECRETO_JWT_MINIMO_64_CARACTERES
JWT_ISSUER=PuntoDeVenta
JWT_AUDIENCE=PuntoDeVenta
# Vida del access token (minutos) para clientes sin refresh token.
JWT_TIME_TOKEN=2000

# Vida del access token (minutos) para clientes que SI usan refresh token
# (web y móvil). Es corta a propósito: la sesión larga la sostiene el refresh
# token, que sí se puede revocar. Empezar holgado (240 = 4 h) y bajar a 60
# una vez verificado que la renovación automática funciona.
JWT_TIME_TOKEN_REFRESHABLE=240
# Días que dura la sesión sin volver a pedir contraseña ni 2FA.
JWT_REFRESH_TOKEN_DAYS=30

# Origen exacto desde el que se sirve la web, para CORS.
# Debe coincidir letra por letra: con esquema y SIN barra final.
# Si este valor falta o no coincide, el navegador bloquea TODAS las llamadas
# a la API y la web queda inutilizable.
CORS_ORIGIN_WEB=https://app.ideanueva.com

# MFA / TOTP  (32 bytes en hexadecimal = exactamente 64 caracteres)
MFA_ENCRYPTION_KEY=CAMBIAR_64_CARACTERES_HEX

# Límites de descuento que puede aplicar un Cajero sin autorización de supervisor
POS_MAX_CASHIER_DISCOUNT_PCT=15
POS_MAX_CASHIER_DISCOUNT_AMOUNT=50
