{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:6001",
  "JwtSettings": {
    "Secret": "REEMPLAZAR_VIA_ENV_JWT_SECRET",
    "Issuer": "PuntoDeVenta",
    "Audience": "PuntoDeVenta",
    "TimeToken": "2000",
    "TimeTokenRefreshable": "60",
    "RefreshTokenDays": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:8080"
    ]
  },
  "LoginSettings": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "RateLimiting": {
    "//": "Intentos de login por IP y por ventana. Ojo: varios cajeros tras un mismo NAT comparten IP publica, por eso el limite es holgado; el freno fino es LoginSettings (bloqueo por cuenta).",
    "LoginPermitLimit": 20,
    "LoginWindowMinutes": 1
  },
  "ForwardedHeaders": {
    "//": "IPs de los proxys inversos en los que se confia para leer X-Forwarded-For. Loopback ya se acepta por defecto; agregar aqui la IP de nginx si corre en otro host.",
    "KnownProxies": [],
    "//TrustAllProxies": "Poner en true solo si el puerto de la API no es alcanzable desde internet (caso Docker con puertos publicados en 127.0.0.1). Ignora KnownProxies.",
    "TrustAllProxies": false
  },
  "MfaSettings": {
    "EncryptionKeyHex": "REEMPLAZAR_VIA_ENV_MFA_KEY_64_HEX_CHARS_000000000000000000000000",
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15,
    "Issuer": "PuntoDeVenta"
  },
  "PosSettings": {
    "MaxCashierDiscountPct": 15,
    "MaxCashierDiscountAmount": 50
  },
  "ConnectionStrings": {
    "InventoryConnection":   "Server=localhost;Database=punto_venta_pg;User Id=postgres;Password=REEMPLAZAR_VIA_ENV;Port=5432;",
    "FacturacionConnection": "Server=localhost;Database=punto_venta_pg;User Id=postgres;Password=REEMPLAZAR_VIA_ENV;Port=5432;",
    "SeguridadConnection":   "Host=localhost;Database=punto_venta_pg;Username=postgres;Password=REEMPLAZAR_VIA_ENV;Port=5432;"
  },
  "ConfigSiat": {
    "Nit": "1020635028",
    "CodigoAmbiente": "2",
    "CodigoModalidad": "1",
    "CodigoSistema": "723799BD19487DFD5F36036",
    "RazonSocial": "Aqui va Razón Social",
    "ApiKey":"REEMPLAZAR_VIA_ENV_SIAT_APIKEY",
    "UrlQr":"https://pilotosiat.impuestos.gob.bo/consulta/QR?",
    "FirmaPathKeyPrivada":"/siat/Firma/SIMON_BOLIVAR.pem",
    "FirmaPathCertificado":"/siat/Firma/SIMON_BOLIVAR.crt",
    "FirmaPathXsd":"/siat/XSD/",
    "FacturaPathStorage":"/siat/Storage/"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.PostgreSQL.Configuration" ],
    "MinimumLevel": "Warning",
    "WriteTo": [
      {
        "Name": "PostgreSQL",
        "Args": {
          "connectionString": "SeguridadConnection",
          "tableName": "zlogs_app",
          "needAutoCreateTable": true,
          "autoCreateSqlTable": true
        }
      }
      
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Columns": {
    "message": "RenderedMessageColumnWriter",
    "message_template": "MessageTemplateColumnWriter",
    "level": {
      "Name": "LevelColumnWriter",
      "Args": {
        "renderAsText": true,
        "dbType": "Varchar"
      }
    },
    "raise_date": "TimestampColumnWriter",
    "exception": "ExceptionColumnWriter",
    "properties": "LogEventSerializedColumnWriter",
    "props_test": {
      "Name": "PropertiesColumnWriter",
      "Args": { "dbType": "Json" }
    },
    "custom_id": {
      "Name": "SinglePropertyColumnWriter",
      "Args": {
        "propertyName": "CustomId",
        "dbType": "Varchar"
      } 
    },
    "cuid": {
      "Name": "SinglePropertyColumnWriter",
      "Args": {
        "propertyName": "Cuid",
        "dbType": "Varchar"
      }
    }
  }
}
