VITE_STAGE=dev
# localhost y no 127.0.0.1: el navegador los trata como sitios distintos, y
# con 127.0.0.1 no enviaria la cookie SameSite=Lax del refresh token.
VITE_API_SERVICIOS='http://localhost:6001/api/'
VITE_API_SERVICIOS_prod='https://api.ideanueva.com/api/'

# Cloudflare Turnstile (captcha del login). Site key de prueba de Cloudflare:
# siempre aprueba y no valida el dominio, asi que sirve en localhost. Va con la
# secret key de prueba en appsettings.Development.json.
# Vacia = el widget no se muestra y el login funciona como antes.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA