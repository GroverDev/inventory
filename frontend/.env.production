VITE_API_SERVICIOS=https://api.ideanueva.com/api/

# Dominio de medios (imagenes de productos), servido por Nginx desde disco. Con
# barra final. Vacia = no se muestran imagenes, solo el marcador. Ajustar al
# dominio real que se configure en Nginx.
VITE_MEDIA_URL=https://media.ideanueva.com/

# Site key real del widget de Cloudflare Turnstile (publica, se hornea en el
# bundle). Vacia = el captcha no se muestra. Al completarla hay que rebuildear
# la imagen del front: las VITE_* se resuelven en tiempo de compilacion.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAEB-6Vgbu4Fh_iVQ
