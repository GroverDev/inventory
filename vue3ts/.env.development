# Solo para `npm run dev`. Sin esto baseURL queda vacío y las llamadas van al propio Vite (404).
# localhost y no 127.0.0.1: el navegador los trata como sitios distintos, y
# con 127.0.0.1 no enviaria la cookie SameSite=Lax del refresh token.
VITE_API_SERVICIOS='http://localhost:6001/api/'

# Site key de prueba de Cloudflare Turnstile: siempre aprueba. Vacia = el widget no se muestra.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# En desarrollo la propia API sirve /media/ (ver Program.cs).
VITE_MEDIA_URL=http://localhost:6001/media/
